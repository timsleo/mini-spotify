# Azure Cosmos DB (Portal do Azure → sua conta Cosmos DB → Keys)
COSMOS_ENDPOINT=https://<sua-conta>.documents.azure.com:443/
COSMOS_KEY=<sua-primary-key>
COSMOS_DATABASE=mini-spotify

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<um-secret-longo-e-aleatorio>

PORT=3000
